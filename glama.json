 ],
 license: MIT,
 tools: [
 {
 name: clean_web_content,
 description: Scrapes and converts any target web page into clean, LLM-ready structured Markdown, stripping ads, cookie banners, navigation clutter, and script noise. Returns clean markdown body, page title, word count, and extraction metadata. Usage Guidelines: Use this tool to ingest real-time web content into LLM context windows without token waste. Do NOT use for video audio parsing (use clean_youtube_transcript) or local PDF files (use clean_pdf_research).
 },
 {
 name: clean_youtube_transcript,
 description: Extracts high-precision subtitles, timestamped transcripts, and comprehensive AI summaries for any YouTube video using Google Gemini Flash intelligence. Returns full timestamped transcript text, bullet-point summary, video duration, and language metadata. Usage Guidelines: Use when you need to ingest or summarize YouTube video knowledge into agent workflows.
 },
 {
 name: clean_pdf_research,
 description: Parses and extracts structured plain text, sections, and academic metadata from online PDF whitepapers and arXiv research documents. Returns parsed markdown text, section headers, page count, and citation references. Usage Guidelines: Use when ingesting scientific papers, technical specs, or financial PDF reports.
 },
 {
 name: clean_batch_scrape,
 description: Concurrently scrapes and extracts clean markdown from up to 10 URLs in parallel with high-speed async processing. Returns a JSON array of parsed web documents with individual status codes and content bodies. Usage Guidelines: Use when an agent needs to perform multi-source research across multiple search results simultaneously.
 },
 {
 name: get_pass_status,
 description: Checks the active subscription status, remaining query quota, and validity period for an agent EVM wallet address (0x...) or Lemon Squeezy Pass Token. Returns pass tier, remaining balance, and expiration timestamp. Usage Guidelines: Use to verify micropayment allowance or query entitlements before dispatching heavy scrape batches.
 }
 ]
}
