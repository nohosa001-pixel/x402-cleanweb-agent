  ": https://glama.ai/mcp/schemas/server.json,
 name: polygon-x402-cleanweb-agent,
 description: Zero-human Web3 micropayment MCP agent for LLM-ready clean web scraping, YouTube transcripts with Gemini 3.6 Flash intelligence, and PDF paper extraction with multi-chain USDC settlement (Polygon, Base, Arbitrum).,
 homepage: https://github.com/nohosa001-pixel/x402-cleanweb-agent,
 maintainers: [
